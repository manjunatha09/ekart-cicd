// Jenkinsfile — ekart-cicd
//
// Flow:
// GitHub webhook
//   -> Jenkins
//   -> Maven build + unit tests
//   -> SonarQube
//   -> Quality Gate
//   -> OWASP Dependency Check
//   -> Trivy filesystem scan
//   -> Docker build
//   -> Trivy image scan
//   -> Docker Hub
//   -> update Kubernetes manifest
//   -> kubectl apply
//   -> Kubernetes
//   -> Worker 1 / Worker 2
//
// Jenkins directly deploys to Kubernetes.
// Argo CD is NOT used.
//
// [ci skip] guard is kept for safety, although Jenkins
// no longer creates a Git commit.

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    triggers {
        githubPush()
    }

    environment {
        DOCKER_IMAGE         = "manja098/ekart"
        SONAR_HOST_URL       = "http://13.233.196.193:9000"
        K8S_DEPLOYMENT_FILE  = "kubernetes/deployment.yaml"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Guard: skip bot commits') {
            steps {
                script {
                    def lastMsg = sh(
                        script: "git log -1 --pretty=%B",
                        returnStdout: true
                    ).trim()

                    if (lastMsg.contains('[ci skip]')) {
                        echo "Last commit contains [ci skip]."
                        echo "Skipping pipeline to prevent a CI loop."

                        currentBuild.result = 'NOT_BUILT'
                        error("Stopping: [ci skip] commit.")
                    }
                }
            }
        }

        stage('Maven Build & Unit Tests') {
            steps {
                dir('app') {
                    sh 'mvn -B clean verify'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('app') {
                    withSonarQubeEnv('sonarqube-server') {
                        sh """
                            mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                              -Dsonar.projectKey=ekart-cicd \
                              -Dsonar.host.url=${SONAR_HOST_URL}
                        """
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dir('app') {
                    dependencyCheck(
                        additionalArguments: '--scan . --format HTML --format XML',
                        odcInstallation: 'owasp-dc'
                    )

                    dependencyCheckPublisher(
                        pattern: 'dependency-check-report.xml'
                    )
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                dir('app') {
                    sh '''
                        trivy fs \
                          --exit-code 0 \
                          --severity HIGH,CRITICAL \
                          --format table \
                          -o trivy-fs-report.txt \
                          .
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('app') {
                    sh "docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} ."
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                    trivy image \
                      --exit-code 0 \
                      --severity HIGH,CRITICAL \
                      --format table \
                      -o app/trivy-image-report.txt \
                      ${DOCKER_IMAGE}:${BUILD_NUMBER}
                """
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x

                        echo "$DOCKER_PASSWORD" | \
                            docker login \
                            -u "$DOCKER_USER" \
                            --password-stdin

                        docker push "${DOCKER_IMAGE}:${BUILD_NUMBER}"

                        docker logout || true
                    '''
                }
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                sh """
                    sed -i \
                      "s|image: ${DOCKER_IMAGE}:.*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" \
                      ${K8S_DEPLOYMENT_FILE}

                    echo "======================================"
                    echo "Updated Kubernetes Manifest"
                    echo "======================================"

                    cat ${K8S_DEPLOYMENT_FILE}
                """
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh """
                    echo "======================================"
                    echo "Deploying EKART to Kubernetes"
                    echo "======================================"

                    kubectl apply -f ${K8S_DEPLOYMENT_FILE}
                    kubectl apply -f kubernetes/service.yaml    
                """
            }
        }

        stage('Verify Kubernetes Deployment') {
            steps {
                sh """
                    echo "======================================"
                    echo "Waiting for EKART rollout"
                    echo "======================================"

                    kubectl rollout status deployment/ekart --timeout=180s

                    echo "======================================"
                    echo "Kubernetes Pods"
                    echo "======================================"

                    kubectl get pods -o wide

                    echo "======================================"
                    echo "Kubernetes Services"
                    echo "======================================"

                    kubectl get services
                """
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'

            archiveArtifacts(
                artifacts: 'app/trivy-*-report.txt, app/dependency-check-report.html',
                allowEmptyArchive: true
            )
        }

        success {
            echo """
            ======================================
            EKART CI/CD PIPELINE SUCCESS
            ======================================

            Build:
            ${BUILD_NUMBER}

            Docker image:
            ${DOCKER_IMAGE}:${BUILD_NUMBER}

            Docker image pushed to Docker Hub.

            Kubernetes deployment completed.

            Jenkins deployed EKART directly to
            the Kubernetes cluster.

            Argo CD is NOT used.
            ======================================
            """
        }

        failure {
            echo """
            ======================================
            EKART PIPELINE FAILED
            ======================================

            Build:
            ${BUILD_NUMBER}

            Check the failed stage above.

            Kubernetes deployment may not have
            been changed if the failure occurred
            before the deployment stage.
            ======================================
            """
        }
    }
}
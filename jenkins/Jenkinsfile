// Jenkinsfile — ekart-cicd
//
// Flow:
// GitHub webhook
//   -> Jenkins
//   -> Maven build + unit tests
//   -> SonarQube
//   -> Quality Gate
//   -> OWASP Dependency Check
//   -> Trivy filesystem scan
//   -> Docker build
//   -> Trivy image scan
//   -> Docker Hub
//   -> update Kubernetes manifest
//   -> GitHub
//   -> Argo CD
//   -> Kubernetes
//
// IMPORTANT:
// Jenkins never runs `kubectl apply`.
// Jenkins only updates the Kubernetes manifest in Git.
// Argo CD owns the actual Kubernetes deployment.
//
// [ci skip] prevents Jenkins' own manifest-update commit
// from causing another CI build.

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    triggers {
        githubPush()
    }

    environment {
        DOCKER_IMAGE        = "manja098/ekart"
        SONAR_HOST_URL      = "http://13.233.196.193:9000"
        K8S_DEPLOYMENT_FILE = "kubernetes/deployment.yaml"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Guard: skip bot commits') {
            steps {
                script {
                    def lastMsg = sh(
                        script: "git log -1 --pretty=%B",
                        returnStdout: true
                    ).trim()

                    if (lastMsg.contains('[ci skip]')) {
                        echo "Last commit was produced by Jenkins."
                        echo "Skipping pipeline to prevent a CI loop."

                        currentBuild.result = 'NOT_BUILT'
                        error("Stopping: [ci skip] commit.")
                    }
                }
            }
        }

        stage('Maven Build & Unit Tests') {
            steps {
                dir('app') {
                    sh 'mvn -B clean verify'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('app') {
                    withSonarQubeEnv('sonarqube-server') {
                        sh """
                            mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                              -Dsonar.projectKey=ekart-cicd \
                              -Dsonar.host.url=${SONAR_HOST_URL}
                        """
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dir('app') {
                    dependencyCheck(
                        additionalArguments: '--scan . --format HTML --format XML',
                        odcInstallation: 'owasp-dc'
                    )

                    dependencyCheckPublisher(
                        pattern: 'dependency-check-report.xml'
                    )
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                dir('app') {
                    sh '''
                        trivy fs \
                          --exit-code 0 \
                          --severity HIGH,CRITICAL \
                          --format table \
                          -o trivy-fs-report.txt \
                          .
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('app') {
                    sh "docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} ."
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                    trivy image \
                      --exit-code 0 \
                      --severity HIGH,CRITICAL \
                      --format table \
                      -o app/trivy-image-report.txt \
                      ${DOCKER_IMAGE}:${BUILD_NUMBER}
                """
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x

                        echo "$DOCKER_PASSWORD" | \
                            docker login \
                            -u "$DOCKER_USER" \
                            --password-stdin

                        docker push "${DOCKER_IMAGE}:${BUILD_NUMBER}"

                        docker logout || true
                    '''
                }
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                sh """
                    sed -i \
                      "s|image: ${DOCKER_IMAGE}:.*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" \
                      ${K8S_DEPLOYMENT_FILE}

                    echo "Updated Kubernetes manifest:"
                    cat ${K8S_DEPLOYMENT_FILE}
                """
            }
        }

        stage('Commit & Push Manifest') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x

                        git config user.email "jenkins@ekart-cicd.local"
                        git config user.name "jenkins-bot"

                        git add "$K8S_DEPLOYMENT_FILE"

                        git commit \
                          -m "[ci skip] deploy: ${DOCKER_IMAGE}:${BUILD_NUMBER}" \
                          || echo "Nothing to commit"

                        cat > "$WORKSPACE/git-askpass.sh" <<'EOF'
#!/bin/sh
case "$1" in
    *Username*) echo "$GITHUB_USER" ;;
    *Password*) echo "$GITHUB_TOKEN" ;;
esac
EOF

                        chmod 700 "$WORKSPACE/git-askpass.sh"

                        trap 'rm -f "$WORKSPACE/git-askpass.sh"' EXIT

                        export GIT_ASKPASS="$WORKSPACE/git-askpass.sh"
                        export GIT_TERMINAL_PROMPT=0

                        git push origin HEAD:main
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'

            archiveArtifacts(
                artifacts: 'app/trivy-*-report.txt, app/dependency-check-report.html',
                allowEmptyArchive: true
            )
        }

        success {
            echo """
            Build ${BUILD_NUMBER} completed successfully.

            Docker image:
            ${DOCKER_IMAGE}:${BUILD_NUMBER}

            Kubernetes manifest was updated and pushed to GitHub.

            Argo CD should detect the Git change and synchronize
            the Kubernetes deployment.
            """
        }

        failure {
            echo """
            Pipeline failed at build ${BUILD_NUMBER}.

            The current Kubernetes deployment remains unchanged
            because Jenkins does not run kubectl apply.
            """
        }
    }
}

